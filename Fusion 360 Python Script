def run(context):
    ui = None
    try:
        app    = adsk.core.Application.get()
        ui     = app.userInterface
        design = app.activeProduct

        if not isinstance(design, adsk.fusion.Design):
            ui.messageBox("Please open a Fusion 360 Design document first.")
            return

        design.designType = adsk.fusion.DesignTypes.DirectDesignType

        print("\n" + "="*60)
        print("FLOODSENSE v6.0 — 5mm WALLS + EXTERNAL O-RING GROOVES")
        print("="*60)

        errors = []

        for label, fn in [("Base", build_base), ("Middle", build_middle), ("Top", build_top)]:
            try:
                fn(design)
            except Exception:
                errors.append(f"{label}:\n{traceback.format_exc()}")

        try:
            app.activeViewport.fit()
        except:
            pass

        if errors:
            ui.messageBox("Errors:\n\n" + "\n\n".join(errors))
        else:
            ui.messageBox(
                "✅  FloodSense v6.0  Complete!\n\n"

                "CHANGES FROM v5:\n"
                "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
                "• WALL_T: 4mm → 5mm\n"
                "  (INNER_R now 35mm, all derived dims updated)\n\n"

                "• O-ring grooves: internal annular → EXTERNAL perimeter band\n"
                "  Each joint face gets a 2.0mm deep × 2.0mm wide channel\n"
                "  cut into the OUTSIDE of the wall.\n"
                "  Upper + lower unit each contribute half → 4mm combined\n"
                "  channel captures a 2.8mm cross-section O-ring.\n\n"

                "GROOVE LOCATIONS:\n"
                "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
                "• Base   TOP    → external groove (mates with Middle bottom)\n"
                "• Middle BOTTOM → external groove (mates with Base top)\n"
                "• Middle TOP    → external groove (mates with Top bottom)\n"
                "• Top    BOTTOM → external groove (mates with Middle top)\n\n"

                "RETAINED (unchanged):\n"
